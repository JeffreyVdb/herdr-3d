node_modules/
dist*/
bin/
*.db
*.db-wal
*.db-shm
.env
.DS_Store
test-results/
playwright-report/
internal/webdist/game/*
!internal/webdist/game/.gitkeep
bin/release/

# Music: licensed tracks are fetched by `pnpm -C game music`, never committed.
game/public/music/
game/music/.cache/
game/music/incoming/*
!game/music/incoming/.gitkeep

# Private deployment config: real hosts and users live outside the repository
# (~/.config/h3d/update.env, the Mac's installed LaunchAgent plist); only the *.example files are tracked.
update.env
.env.*
!.env.example
!*.example

# Database backups (h3d-update writes world.db.bak, sqlite3 .backup copies).
*.db.bak
*.db.*
