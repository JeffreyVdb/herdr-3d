# Private config of h3d-helper (deprecated fallback, removed with the cutover, issue #253).
# Copy it to (chmod 600)
#   ~/Library/Application Support/h3d-helper/helper.env     on the Mac
#   (or the file named by $H3D_HELPER_CONFIG)
# h3d-update installs it by itself when the Mac has no bridge host configured.
#
# The flag and the environment win over this file. The way to set the host without it
# is H3D_HELPER_HOST / H3D_HELPER_REMOTE_SOCKET in the LaunchAgent's EnvironmentVariables
# (deploy/com.jeffreyvdb.h3d-helper.plist). KEY=VALUE lines, # comments; only these two
# keys are read, anything else is ignored.

# ssh destination of the bridge server. Required: the helper has no default.
H3D_HELPER_HOST=dev@devbox

# The bridge socket on that host. Optional: unset, the helper asks the host for
# $XDG_RUNTIME_DIR and uses $XDG_RUNTIME_DIR/herdr-world/bridge.sock.
H3D_HELPER_REMOTE_SOCKET=/run/user/1000/herdr-world/bridge.sock
