<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  h3d-helper as a user LaunchAgent on the Mac (see CONTRIBUTING.md "Helper").
  launchd does not expand ~ or $HOME, and it does not see your shell's exports. The helper has
  no built-in bridge host: fill in the placeholders when installing (user@host of the bridge
  server, and its bridge socket; leave H3D_HELPER_REMOTE_SOCKET empty to have the helper ask
  the host for its $XDG_RUNTIME_DIR):
    sed -e "s|@HOME@|$HOME|g" \
        -e "s|@H3D_HELPER_HOST@|dev@devbox|g" \
        -e "s|@H3D_HELPER_REMOTE_SOCKET@|/run/user/1000/herdr-world/bridge.sock|g" \
        deploy/com.jeffreyvdb.h3d-helper.plist > ~/Library/LaunchAgents/com.jeffreyvdb.h3d-helper.plist
    launchctl bootout gui/$(id -u)/com.jeffreyvdb.h3d-helper 2>/dev/null; launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jeffreyvdb.h3d-helper.plist
  Other flags can go into ProgramArguments, other H3D_HELPER_* into EnvironmentVariables.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jeffreyvdb.h3d-helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/.local/bin/h3d-helper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart it whenever it exits; it restarts its own ssh tunnel. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<!-- It sits between the game window and the bridge: no background throttling. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>H3D_HELPER_HOST</key>
		<string>@H3D_HELPER_HOST@</string>
		<key>H3D_HELPER_REMOTE_SOCKET</key>
		<string>@H3D_HELPER_REMOTE_SOCKET@</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/h3d-helper.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/h3d-helper.log</string>
</dict>
</plist>
