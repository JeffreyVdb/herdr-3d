# Private config of h3d-update, read on the bridge server. Copy it to
#   ${XDG_CONFIG_HOME:-~/.config}/h3d/update.env     (chmod 600)
# and fill in your own machines. Real values never go into the repository
# (.gitignore keeps update.env out). KEY=VALUE lines, # comments; the file is read
# as data, never sourced, and only these three keys are used. A variable already
# set in the environment wins over this file.

# ssh destination of the Mac running h3d-helper. There is no default: without it
# h3d-update stops, unless you pass --server-only.
H3D_MAC=devmac

# Migration guard (deprecated, removed with the cutover, issue #253): if the Mac's
# helper has no H3D_HELPER_HOST in its LaunchAgent plist or its helper config, h3d-update
# installs ~/Library/Application Support/h3d-helper/helper.env on the Mac from these
# two before it swaps the helper binary. Without H3D_HELPER_HOST here it stops instead.
H3D_HELPER_HOST=dev@devbox
# Optional. Unset or empty: the helper asks the host for $XDG_RUNTIME_DIR.
H3D_HELPER_REMOTE_SOCKET=/run/user/1000/herdr-world/bridge.sock
