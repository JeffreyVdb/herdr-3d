# Private config of h3d-update, read on the bridge server. Copy it to
#   ${XDG_CONFIG_HOME:-~/.config}/h3d/update.env     (chmod 600)
# and fill in your own machines. Real values never go into the repository
# (.gitignore keeps update.env out). KEY=VALUE lines, # comments; the file is read
# as data, never sourced, and only H3D_MAC is used (other keys are ignored). A
# variable already set in the environment wins over this file.
#
# The Mac's helper is not configured here: its bridge host is in its LaunchAgent
# plist (deploy/com.jeffreyvdb.h3d-helper.plist, docs/releasing.md).

# ssh destination of the Mac running h3d-helper. There is no default: without it
# h3d-update stops, unless you pass --server-only.
H3D_MAC=devmac
